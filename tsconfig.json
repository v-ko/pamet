{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable", "WebWorker"],
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      // For tandem development of the sivkit lib (sibling repo).
      // (should?) Falls back to the npm package if the local path doesn't exist.
      "sivkit/*": ["../sivkit/typescript/src/*"],
      "@/*": ["./web-app/src/*"]
    },
    "types": ["node", "vite/client", "jest"]
  },
  "include": [
    "../sivkit/typescript/src/**/*.ts",
    "../sivkit/typescript/src/**/*.tsx",
    "web-app/src/**/*.ts",
    "web-app/src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/*.d.ts"]
}
